{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)mobile'",
  "functions": {
    "src/app/api/schedules/notifications/route.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    }
  },
  "schedules": {
    "notifications": {
      "schedule": "0 * * * *",
      "timezone": "America/New_York",
      "function": "api/schedules/notifications"
    }
  }
}
