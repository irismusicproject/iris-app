# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. The Supabase SECRET key (sb_secret_…), for sending invites and
# blocking sign-in. Never commit it and never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=
# Base URL used in sign-in emails (no trailing slash). Set on Production only;
# Vercel previews use their own address (src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only (v0.24). Resend API key for emails the app sends itself (the
# welcome email; notifications when NOTIFICATIONS_ENABLED is "true"). Locally,
# emails go to the local mail viewer instead. Never commit it.
RESEND_API_KEY=
# Server-only. Queued notifications (No Program, deadline reminders) are
# sent only when this is "true"; otherwise they stay in the admin Outbox.
# The Resend key alone sends just sign-in emails such as the welcome email.
NOTIFICATIONS_ENABLED=
# Server-only (v0.24). The scheduler calls /api/cron/notifications with
# "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=
