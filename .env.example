# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. The Supabase SECRET key (sb_secret_…), for sending invites and
# blocking sign-in. Never commit it and never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=
# Base URL used in sign-in emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
