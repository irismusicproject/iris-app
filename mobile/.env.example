# Copy to .env.local (never committed) for `npx expo start` on your computer.
# Staging's project URL and publishable key (sb_publishable_…): both are public
# by design. Never put a secret key here. Test builds made with EAS get these
# from Expo's "preview" environment instead (eas.json).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "staging" shows a small "test version" line on sign-in and More.
EXPO_PUBLIC_IRIS_ENVIRONMENT=staging
